# cp .env.example .env でコピーして使う（.env は GitHub に上げない）

# データベース。下は npm run dev で起動する開発用DB（プロジェクト内の .data/postgres）。本番は Neon などの接続文字列にする
DATABASE_URL="postgresql://gymcrm:gymcrm@localhost:54330/gymcrm?schema=public"

# ログイン用の秘密鍵（openssl rand -base64 32 で作った値に置き換える）と、アプリのURL（本番は公開URL）
BETTER_AUTH_SECRET="ここを置き換える"
BETTER_AUTH_URL="http://localhost:3020"

# 開発中だけ: 開発用オーナーの作成とワンクリックログイン（本番では設定しない）
DEV_LOGIN="true"
DEV_OWNER_EMAIL="owner@example.com"
DEV_OWNER_PASSWORD="10文字以上のパスワードに置き換える"

# 1 でデモ顧客4人を投入（本番では設定しない）
SEED_DEMO="1"
