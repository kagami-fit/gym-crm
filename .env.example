# cp .env.example .env でコピーして使う（.env は GitHub に上げない）

# データベース。下は npm run dev で起動する開発用DB（プロジェクト内の .data/postgres）。
# 公開先では Neon の接続文字列（DATABASE_URL＝プール経由、DATABASE_URL_UNPOOLED＝直接。開発中はどちらも同じ）
DATABASE_URL="postgresql://gymcrm:gymcrm@localhost:54330/gymcrm?schema=public"
DATABASE_URL_UNPOOLED="postgresql://gymcrm:gymcrm@localhost:54330/gymcrm?schema=public"

# ログイン用の秘密鍵（openssl rand -base64 32 で作った値に置き換える）と、アプリのURL（本番は公開URL）
BETTER_AUTH_SECRET="ここを置き換える"
BETTER_AUTH_URL="http://localhost:3020"

# 開発中だけ: 開発用オーナーの作成とワンクリックログイン（本番では設定しない）
DEV_LOGIN="true"
DEV_OWNER_EMAIL="owner@example.com"
DEV_OWNER_PASSWORD="10文字以上のパスワードに置き換える"

# 1 でデモ顧客4人を投入（本番では設定しない）
SEED_DEMO="1"

# 公開デモだけ（Netlify の環境変数に入れる）: 「デモを見る」でログインなしに入れる。本当のお客様の情報は入れない
# DEMO_MODE="true"
# DEMO_USER_EMAIL="demo@example.com"
# DEMO_USER_PASSWORD="ランダムな長い文字列"
# BETTER_AUTH_TRUSTED_ORIGINS="https://*--resole-gym-crm.netlify.app"
