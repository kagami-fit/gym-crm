{
  "name": "gym-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9",
    "npm": ">=9"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev -p 3020 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 3020",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "user:create": "tsx scripts/create-user.ts",
    "prod:migrate": "node --env-file=.env.production.local node_modules/prisma/build/index.js migrate deploy",
    "prod:seed": "NODE_ENV=production tsx --env-file=.env.production.local prisma/seed.ts",
    "prod:user": "tsx --env-file=.env.production.local scripts/create-user.ts",
    "deploy": "bash scripts/deploy-cloudflare.sh",
    "deploy:preview": "bash scripts/deploy-cloudflare.sh --preview",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "wrangler dev --port 8787",
    "netlify:preview": "bash scripts/deploy-netlify.sh",
    "netlify:prod": "bash scripts/deploy-netlify.sh --prod"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.1.18",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.4.3",
    "pdfjs-dist": "^5.7.284",
    "perfect-freehand": "^1.2.3",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.28",
    "tailwindcss": "4.1.18",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.156.0"
  }
}
