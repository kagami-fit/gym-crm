generator client {
  provider      = "prisma-client-js"
  // native：開発中のMac／rhel-openssl-3.0.x：公開先（Netlify＝AWS Lambda）
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // アプリは Neon の「プール経由」の接続、マイグレーションは直接の接続を使う（開発中はどちらも同じ）
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────────────────────
// ログイン（Better Auth の標準テーブル）
// ─────────────────────────────────────────────

model User {
  id            String            @id
  name          String
  email         String            @unique
  emailVerified Boolean           @default(false)
  image         String?
  /// owner: 設定・スタッフ管理まで可能 / staff: 顧客の閲覧・記録
  role          String            @default("staff")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  clients       Client[]
  trainings     TrainingSession[]
  talkNotes     TalkNote[]
  reminders     Reminder[]
  alertActions  AlertAction[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────
// 顧客台帳
// ─────────────────────────────────────────────

model Client {
  id                String            @id @default(cuid())
  /// 会員番号（任意・重複不可）
  memberNo          String?           @unique
  name              String
  kana              String?
  /// male / female / other
  gender            String?
  birthDate         DateTime?         @db.Date
  heightCm          Float?
  phone             String?
  email             String?
  address           String?
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?
  occupation        String?
  /// trial（体験）/ active（在籍中）/ paused（休会中）/ left（退会）
  status            String            @default("active")
  joinedOn          DateTime?         @db.Date
  leftOn            DateTime?         @db.Date
  trainerId         String?
  trainer           User?             @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  /// 来店のきっかけ（紹介・SNS など）
  referral          String?
  /// 目的（ダイエット・ボディメイク など、複数）
  purposes          String[]          @default([])
  note              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bodyLogs          BodyLog[]
  goals             Goal[]
  mealMemos         MealMemo[]
  sessions          TrainingSession[]
  questionnaire     Questionnaire?
  talkNotes         TalkNote[]
  reminders         Reminder[]
  alertActions      AlertAction[]
  nutritionWeeks    NutritionWeek[]
  homeworks         Homework[]
  monthlyThemes     MonthlyTheme[]
  phases            ClientPhase[]
  ansMeasurements   AnsMeasurement[]
  movementChecks    MovementCheck[]
  conditionChecks   ConditionCheck[]
  weightReviews     WeightReview[]
  files             ClientFile[]

  @@index([status])
  @@index([kana])
}

/// 体重・体脂肪率（1日1件。ヒアリングでトレーナーが入力）
model BodyLog {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  weightKg   Float?
  bodyFatPct Float?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([clientId, date])
}

/// 食事方針と目標（変更のたびに1件追加して履歴にする。開始日が基準日以前で最新のものが有効）
model Goal {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  startDate       DateTime  @db.Date
  /// 食事方針（recovery 回復食 / balance バランス食 / other そのほか / reverse コーフラックス / loss 減量 / maintain 維持。lib/labels.ts の DIET_POLICIES）
  policy          String    @default("loss")
  /// 方針が「そのほか」のときの名前
  policyName      String?
  startWeightKg   Float?
  startBodyFatPct Float?
  /// 目標体重（減量）・維持したい体重（維持）。そのほかの方針では、お客様の最終的な目標体重（任意）
  targetWeightKg  Float?
  /// 設定の減量ペース（paces[].key）。減量のときだけ使う
  paceKey         String?
  activityFactor  Float?
  /// お客様の目標日（方針を変えても引き継ぐ）
  targetDate      DateTime? @db.Date
  /// 終了予定日（コーフラックス）
  endDate         DateTime? @db.Date
  /// 方針を見直す予定日
  reviewDate      DateTime? @db.Date
  /// 理由・メモ
  note            String?
  createdById     String?
  createdAt       DateTime  @default(now())

  @@index([clientId, startDate])
}

/// 食事メモ（slot: breakfast / lunch / dinner / snack / note）
model MealMemo {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  slot      String
  text      String
  updatedAt DateTime @updatedAt

  @@unique([clientId, date, slot])
}

// ─────────────────────────────────────────────
// トレーニング
// ─────────────────────────────────────────────

/// 来店1回分のトレーニング（この日付が「来店日」になる）
model TrainingSession {
  id        String          @id @default(cuid())
  clientId  String
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      DateTime        @db.Date
  trainerId String?
  trainer   User?           @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  memo      String?
  /// その回のテーマ（例：伸展）
  theme     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sets      TrainingSet[]
  drawing   SessionDrawing?
  files     ClientFile[]

  @@index([clientId, date])
}

/// セッションごとの手書きメモ（Apple Pencil・指で書いた線をベクターで保存。形式は lib/drawing.ts）
model SessionDrawing {
  id          String          @id @default(cuid())
  sessionId   String          @unique
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  data        Json
  /// 一覧に出す小さな表示（最初のページを間引いた線。保存のたびに作り直す。lib/drawing.ts の drawingThumb）
  thumb       Json?
  updatedById String?
  updatedAt   DateTime        @updatedAt
}

/// 会話メモ（会話で出た「通って変化を感じたこと」「良かったこと」「ネガティブな言動」「身体の変化」などを日付と一緒に残す）
model TalkNote {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  /// talk（会話）/ change（変化を感じた）/ good（良かったこと）/ negative（ネガティブな言動）/ body（身体の変化）。lib/labels.ts の TALK_KINDS
  kind        String   @default("talk")
  text        String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId, date])
}

/// 種目ごとの記録。weightKg・reps・sets は「まとめ」（セットごとに入れたときは一番重いセットとセット数。計算と前回比べに使う）。
/// セットごとの重さ・回数・秒数・左右は detail、器具・バネ（1R＋1Y など）・できばえも残せる（2026-10 手書きのログに合わせて追加）
model TrainingSet {
  id        String          @id @default(cuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order     Int
  bodyPart  String
  exercise  String
  weightKg  Float
  reps      Int
  sets      Int
  note      String?
  /// その種目をやる目的（設定の「目的の選択肢」から選ぶ。名前で持つので、選択肢を消しても記録は残る）
  purpose   String?
  /// 器具（タワー・リフォーマー・チェア・マット・スミスマシンなど。lib/log.ts の EQUIPMENT）
  equipment String?
  /// バネ（ピラティスマシンのスプリング）。本数＋色＋強度の略記を「＋」でつなぐ（1R＋1Y、B2 など。lib/log.ts）
  springs   String?
  /// セットごとの内容 [{ w: 重さkg, r: 回数, s: 秒, side: R|L }]（空なら weightKg×reps×sets）
  detail    Json?
  /// できばえ（great ◎ / good ○ / hard △ / ng ×）
  rating    String?

  @@index([sessionId])
  @@index([exercise])
}

/// 種目マスタ
model Exercise {
  id        String  @id @default(cuid())
  bodyPart  String
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  /// いつもの目的（記録でこの種目を選ぶと、目的に自動で入る）
  purpose   String?

  @@unique([bodyPart, name])
}

// ─────────────────────────────────────────────
// 問診票・設定
// ─────────────────────────────────────────────

/// 問診票（項目の定義は lib/questionnaire.ts。回答はJSONで持つので項目の追加・変更がしやすい）
model Questionnaire {
  id          String    @id @default(cuid())
  clientId    String    @unique
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  answeredOn  DateTime? @db.Date
  answers     Json
  updatedById String?
  updatedAt   DateTime  @updatedAt
}

/// アプリ設定（key: "calc" に計算設定一式を JSON で保存）
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────
// お知らせ（アラート）
// 自動のお知らせ（停滞・伸びていない種目など）はデータから毎回計算し、対応（AlertAction）だけを保存する。
// 自分で作るお知らせ（Reminder）はトレーナーが書いて保存する。条件と段階の設定は AppSetting の "alerts"
// ─────────────────────────────────────────────

/// 自分で作るお知らせ（トレーナーがお客様ごとに自由に書く）
model Reminder {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  text        String
  /// date（日付を指定）/ next_visit（次の来店時）
  trigger     String    @default("date")
  /// date：知らせる日／next_visit：作った日（この日より後に来店したら知らせる）
  dueDate     DateTime  @db.Date
  /// info（黄・気づき）/ warn（橙・要対応）/ alert（赤・相談）
  level       String    @default("info")
  /// open / done
  status      String    @default("open")
  snoozeUntil DateTime? @db.Date
  doneAt      DateTime?
  doneNote    String?
  doneById    String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId, status])
}

/// 自動のお知らせへの対応（対応した／あとで／このお客様では止める・再開）。fingerprint（状況）が変わるとまた出る
model AlertAction {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// plateau / noProgress / dietFlat / noVisit / behindPace / talk（lib/alerts/rules.ts）
  rule        String
  /// 状況を表す文字列（止める・再開は "*"）
  fingerprint String
  /// done / snooze / mute / unmute
  action      String
  until       DateTime? @db.Date
  note        String?
  byId        String?
  by          User?     @relation(fields: [byId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([clientId, rule])
}

/// 週ごとの食事の数字（ヒアリングで手入力。停滞のお知らせにも使う）
model NutritionWeek {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// その週の月曜日
  weekStart   DateTime @db.Date
  /// 設定カロリー（目標）
  targetKcal  Float?
  /// 平均カロリー（実績）
  avgKcal     Float?
  proteinG    Float?
  fatG        Float?
  carbsG      Float?
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([clientId, weekStart])
}

// ─────────────────────────────────────────────
// カルテ・顧客ステップ
// ─────────────────────────────────────────────

/// 宿題（お客様に出した Todo）。次の来店で「できた／一部／できなかった」を確認する
model Homework {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  text        String
  assignedOn  DateTime  @db.Date
  /// open（未確認）/ done（できた）/ partial（一部）/ not_done（できなかった）
  status      String    @default("open")
  checkedOn   DateTime? @db.Date
  note        String?
  createdById String?
  checkedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId, status])
}

/// 月ごとのテーマ（月のテーマ・トレーニングテーマ）
model MonthlyTheme {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  month         String
  theme         String?
  trainingTheme String?
  updatedById   String?
  updatedAt     DateTime @updatedAt

  @@unique([clientId, month])
}

/// お客様のフェーズ（フェーズ1：体を整える／フェーズ2：目的に合わせて進める）。体重のグラフに色分けで重ねる
model ClientPhase {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime  @db.Date
  /// 空なら続いている（次のフェーズの開始日の前日までとして扱う）
  endDate        DateTime? @db.Date
  /// 見直し予定日
  reviewDate     DateTime? @db.Date
  /// 来店頻度（週1回・週2回 など）
  visitFrequency String?
  /// このフェーズにした理由（最初のフェーズは「この段階から始めた理由」）
  note           String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([clientId, startDate])
}

/// 自律神経の測定結果（condiView の測定票の PDF・写真をそのまま保存し、「活性度」の2本の棒を記録する）
model AnsMeasurement {
  id                   String   @id @default(cuid())
  clientId             String
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  measuredOn           DateTime @db.Date
  fileName             String
  mimeType             String
  size                 Int
  data                 Bytes
  /// 交感神経（オレンジの棒）の数値と、グレーゾーンとの位置（low 低い / normal 基準内 / high 高い。空＝未確認）
  sympathetic          Float?
  sympatheticLevel     String?
  /// 副交感神経（青の棒）の数値と位置
  parasympathetic      Float?
  parasympatheticLevel String?
  /// フェーズ1の型（A〜D。対応が確定するまでは仮。空＝未確定）
  ansType              String?
  /// 評価メモ（疲労や症状など、数値と合わせて見た内容）
  note                 String?
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  @@index([clientId, measuredOn])
}

/// 動作の評価（ピラティスの達成状況）。評価のたびに1件ふえる（前の段階へ戻ったことも残る）
model MovementCheck {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  /// 動き（lib/movements.ts の MOVEMENTS の key）
  movement    String
  /// untested 未評価 / practicing 練習中 / achieved 達成（左右がある動きは、左右から決める）
  status      String
  /// 動きごとの確認項目（左右・かかとの接地・腰の痛み など。lib/movements.ts）
  checks      Json?
  /// 実施条件
  condition   String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([clientId, movement, date])
}

/// 体調チェック（本人の訴え）。1日1件。項目は lib/condition.ts
model ConditionCheck {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  /// 項目 → none なし / mild 少し / strong 強い（答えていない項目は入れない）
  items       Json
  /// 痛みの部位
  painArea    String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, date])
}

/// 体重の変化への担当者の評価（想定内／見直しが必要／評価保留）
model WeightReview {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  /// expected 想定内 / review 見直しが必要 / hold 評価保留
  verdict     String
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([clientId, date])
}

/// お客様の写真・資料。来店ごとのログにつけた写真（sessionId あり）と、カルテの原本などの資料（sessionId なし）。
/// お客様ごとの「写真・資料」のタブにすべて日付順にまとまる
model ClientFile {
  id          String           @id @default(cuid())
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  date        DateTime         @db.Date
  /// photo 写真 / document 資料（カルテの原本など）
  kind        String           @default("photo")
  /// 何の写真か（例：パイクアップ B4）
  title       String?
  fileName    String
  mimeType    String
  size        Int
  data        Bytes
  note        String?
  createdById String?
  createdAt   DateTime         @default(now())

  @@index([clientId, date])
  @@index([sessionId])
}
